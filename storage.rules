rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsFiles(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImageWithinLimit() {
      return request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    function isSupportedMediaWithinLimit() {
      return request.resource.size <= 100 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType.matches('video/.*'));
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsFiles(userId) && isImageWithinLimit();
      allow delete: if ownsFiles(userId);
    }

    match /users/{userId}/pets/{petId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsFiles(userId) && isImageWithinLimit();
      allow delete: if ownsFiles(userId);
    }

    match /users/{userId}/media/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsFiles(userId) && isSupportedMediaWithinLimit();
      allow delete: if ownsFiles(userId);
    }
  }
}
