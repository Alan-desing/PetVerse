rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.keys().hasOnly([
            'uid',
            'displayName',
            'email',
            'bio',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'uid',
            'displayName',
            'email',
            'bio',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && data.uid == userId
          && data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 80
          && data.email is string
          && data.bio is string
          && data.bio.size() <= 240
          && (data.photoUrl == null || data.photoUrl is string)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function validPet(data, userId) {
      return data.keys().hasOnly([
            'ownerId',
            'name',
            'type',
            'breed',
            'ageYears',
            'weightKg',
            'bio',
            'photoUrls',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'ownerId',
            'name',
            'type',
            'breed',
            'ageYears',
            'weightKg',
            'bio',
            'photoUrls',
            'createdAt',
            'updatedAt'
          ])
          && data.ownerId == userId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 60
          && data.type in ['dog', 'cat']
          && data.breed is string
          && data.breed.size() <= 80
          && data.ageYears is int
          && data.ageYears >= 0
          && data.ageYears <= 60
          && data.weightKg is number
          && data.weightKg > 0
          && data.weightKg <= 300
          && data.bio is string
          && data.bio.size() <= 240
          && data.photoUrls is list
          && data.photoUrls.size() <= 6
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function validPost(data, userId) {
      return data.keys().hasOnly([
            'authorId',
            'authorName',
            'authorPhotoUrl',
            'caption',
            'mediaUrl',
            'mediaType',
            'likeCount',
            'createdAt'
          ])
          && data.keys().hasAll([
            'authorId',
            'authorName',
            'authorPhotoUrl',
            'caption',
            'mediaUrl',
            'mediaType',
            'likeCount',
            'createdAt'
          ])
          && data.authorId == userId
          && data.authorName is string
          && data.authorName.size() > 0
          && data.authorName.size() <= 80
          && (data.authorPhotoUrl == null || data.authorPhotoUrl is string)
          && data.caption is string
          && data.caption.size() > 0
          && data.caption.size() <= 500
          && (data.mediaUrl == null
              || (data.mediaUrl is string && data.mediaUrl.matches('https://.*')))
          && data.mediaType in ['none', 'image', 'video']
          && ((data.mediaUrl == null && data.mediaType == 'none')
              || (data.mediaUrl is string && data.mediaType in ['image', 'video']))
          && data.likeCount is int
          && data.likeCount == 0
          && data.createdAt is timestamp;
    }

    function likePath(postId, userId) {
      return /databases/$(database)/documents/posts/$(postId)/likes/$(userId);
    }

    function parentPostPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function validLikeCountChange(postId) {
      return signedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likeCount'])
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0
          && ((!exists(likePath(postId, request.auth.uid))
                  && existsAfter(likePath(postId, request.auth.uid))
                  && request.resource.data.likeCount == resource.data.likeCount + 1)
              || (exists(likePath(postId, request.auth.uid))
                  && !existsAfter(likePath(postId, request.auth.uid))
                  && request.resource.data.likeCount == resource.data.likeCount - 1));
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
          && validProfile(request.resource.data, userId)
          && request.resource.data.email == request.auth.token.email;

      allow update: if ownsProfile(userId)
          && validProfile(request.resource.data, userId)
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'bio',
            'photoUrl',
            'updatedAt'
          ]);

      allow delete: if false;

      match /pets/{petId} {
        allow read: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
            && validPet(request.resource.data, userId);
        allow update: if ownsProfile(userId)
            && validPet(request.resource.data, userId)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsProfile(userId);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && validPost(request.resource.data, request.auth.uid);
      allow update: if validLikeCountChange(postId);
      allow delete: if false;

      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn()
            && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && request.resource.data.keys().hasAll(['userId', 'createdAt'])
            && request.resource.data.userId == userId
            && request.resource.data.createdAt is timestamp
            && !exists(likePath(postId, userId))
            && get(parentPostPath(postId)).data.likeCount is int
            && getAfter(parentPostPath(postId)).data.likeCount
                == get(parentPostPath(postId)).data.likeCount + 1;
        allow update: if false;
        allow delete: if signedIn()
            && request.auth.uid == userId
            && get(parentPostPath(postId)).data.likeCount is int
            && getAfter(parentPostPath(postId)).data.likeCount
                == get(parentPostPath(postId)).data.likeCount - 1;
      }

      match /comments/{commentId} {
        allow read: if signedIn() && exists(parentPostPath(postId));
        allow create: if signedIn() && exists(parentPostPath(postId))
            && request.resource.data.keys().hasOnly([
              'authorId',
              'authorName',
              'text',
              'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'authorId',
              'authorName',
              'text',
              'createdAt'
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 80
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if signedIn() && exists(parentPostPath(postId))
            && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
