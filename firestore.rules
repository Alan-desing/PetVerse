rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.keys().hasOnly([
            'uid',
            'displayName',
            'email',
            'bio',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'uid',
            'displayName',
            'email',
            'bio',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && data.uid == userId
          && data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 80
          && data.email is string
          && data.bio is string
          && data.bio.size() <= 240
          && (data.photoUrl == null || data.photoUrl is string)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
          && validProfile(request.resource.data, userId)
          && request.resource.data.email == request.auth.token.email;

      allow update: if ownsProfile(userId)
          && validProfile(request.resource.data, userId)
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'bio',
            'photoUrl',
            'updatedAt'
          ]);

      allow delete: if false;
    }
  }
}
