rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.keys().hasOnly([
            'uid',
            'displayName',
            'email',
            'bio',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'uid',
            'displayName',
            'email',
            'bio',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && data.uid == userId
          && data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 80
          && data.email is string
          && data.bio is string
          && data.bio.size() <= 240
          && (data.photoUrl == null || data.photoUrl is string)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function validPet(data, userId) {
      return data.keys().hasOnly([
            'ownerId',
            'name',
            'type',
            'breed',
            'ageYears',
            'weightKg',
            'bio',
            'photoUrls',
            'location',
            'isForAdoption',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'ownerId',
            'name',
            'type',
            'breed',
            'ageYears',
            'weightKg',
            'bio',
            'photoUrls',
            'location',
            'isForAdoption',
            'createdAt',
            'updatedAt'
          ])
          && data.ownerId == userId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 60
          && data.type in ['dog', 'cat']
          && data.breed is string
          && data.breed.size() <= 80
          && data.ageYears is int
          && data.ageYears >= 0
          && data.ageYears <= 60
          && data.weightKg is number
          && data.weightKg > 0
          && data.weightKg <= 300
          && data.bio is string
          && data.bio.size() <= 240
          && data.photoUrls is list
          && data.photoUrls.size() <= 6
          && data.location is string
          && data.location.size() <= 100
          && data.isForAdoption is bool
          && (!data.isForAdoption || data.location.size() > 0)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function validPost(data, userId) {
      return data.keys().hasOnly([
            'authorId',
            'authorName',
            'authorPhotoUrl',
            'caption',
            'mediaUrl',
            'mediaType',
            'likeCount',
            'createdAt'
          ])
          && data.keys().hasAll([
            'authorId',
            'authorName',
            'authorPhotoUrl',
            'caption',
            'mediaUrl',
            'mediaType',
            'likeCount',
            'createdAt'
          ])
          && data.authorId == userId
          && data.authorName is string
          && data.authorName.size() > 0
          && data.authorName.size() <= 80
          && (data.authorPhotoUrl == null || data.authorPhotoUrl is string)
          && data.caption is string
          && data.caption.size() > 0
          && data.caption.size() <= 500
          && (data.mediaUrl == null
              || (data.mediaUrl is string && data.mediaUrl.matches('https://.*')))
          && data.mediaType in ['none', 'image', 'video']
          && ((data.mediaUrl == null && data.mediaType == 'none')
              || (data.mediaUrl is string && data.mediaType in ['image', 'video']))
          && data.likeCount is int
          && data.likeCount == 0
          && data.createdAt is timestamp;
    }

    function likePath(postId, userId) {
      return /databases/$(database)/documents/posts/$(postId)/likes/$(userId);
    }

    function parentPostPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function validLikeCountChange(postId) {
      return signedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likeCount'])
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0
          && ((!exists(likePath(postId, request.auth.uid))
                  && existsAfter(likePath(postId, request.auth.uid))
                  && request.resource.data.likeCount == resource.data.likeCount + 1)
              || (exists(likePath(postId, request.auth.uid))
                  && !existsAfter(likePath(postId, request.auth.uid))
                  && request.resource.data.likeCount == resource.data.likeCount - 1));
    }

    function adoptionPetPath(ownerId, petId) {
      return /databases/$(database)/documents/users/$(ownerId)/pets/$(petId);
    }

    function validAdoptionRequest(data) {
      return data.keys().hasOnly([
            'petId',
            'petName',
            'ownerId',
            'requesterId',
            'requesterName',
            'requesterEmail',
            'message',
            'createdAt'
          ])
          && data.keys().hasAll([
            'petId',
            'petName',
            'ownerId',
            'requesterId',
            'requesterName',
            'requesterEmail',
            'message',
            'createdAt'
          ])
          && data.petId is string
          && data.petId.size() > 0
          && data.petId.size() <= 128
          && data.petName is string
          && data.petName.size() > 0
          && data.petName.size() <= 60
          && data.ownerId is string
          && data.ownerId != request.auth.uid
          && data.requesterId == request.auth.uid
          && data.requesterName is string
          && data.requesterName.size() > 0
          && data.requesterName.size() <= 80
          && data.requesterEmail is string
          && data.requesterEmail.size() > 0
          && data.requesterEmail.size() <= 254
          && data.requesterEmail == request.auth.token.email
          && data.message is string
          && data.message.size() > 0
          && data.message.size() <= 800
          && data.createdAt is timestamp
          && exists(adoptionPetPath(data.ownerId, data.petId))
          && get(adoptionPetPath(data.ownerId, data.petId)).data.isForAdoption == true;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function chatMessagePath(chatId, messageId) {
      return /databases/$(database)/documents/chats/$(chatId)/messages/$(messageId);
    }

    function adoptionRequestPath(requestId) {
      return /databases/$(database)/documents/adoptionRequests/$(requestId);
    }

    function validChatMessage(data) {
      return data.keys().hasOnly([
            'senderId',
            'senderName',
            'text',
            'createdAt'
          ])
          && data.keys().hasAll([
            'senderId',
            'senderName',
            'text',
            'createdAt'
          ])
          && data.senderId == request.auth.uid
          && data.senderName is string
          && data.senderName.size() > 0
          && data.senderName.size() <= 80
          && data.text is string
          && data.text.size() > 0
          && data.text.size() <= 1000
          && data.createdAt is timestamp;
    }

    function validChatMessageAfter(chatId, data) {
      return data.lastMessageId is string
          && existsAfter(chatMessagePath(chatId, data.lastMessageId))
          && getAfter(chatMessagePath(chatId, data.lastMessageId)).data.senderId
              == request.auth.uid
          && getAfter(chatMessagePath(chatId, data.lastMessageId)).data.text
              == data.lastMessage
          && getAfter(chatMessagePath(chatId, data.lastMessageId)).data.createdAt
              == data.lastMessageAt;
    }

    function validNewChat(data, chatId) {
      return data.keys().hasOnly([
            'petId',
            'petName',
            'ownerId',
            'requesterName',
            'participantIds',
            'lastMessage',
            'lastMessageId',
            'lastSenderId',
            'lastMessageAt',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'petId',
            'petName',
            'ownerId',
            'requesterName',
            'participantIds',
            'lastMessage',
            'lastMessageId',
            'lastSenderId',
            'lastMessageAt',
            'createdAt',
            'updatedAt'
          ])
          && data.petId is string
          && data.petId.size() > 0
          && data.petId.size() <= 128
          && data.petName is string
          && data.petName.size() > 0
          && data.petName.size() <= 60
          && data.ownerId is string
          && data.ownerId != request.auth.uid
          && data.participantIds is list
          && data.participantIds.size() == 2
          && request.auth.uid in data.participantIds
          && data.ownerId in data.participantIds
          && data.requesterName is string
          && data.requesterName.size() > 0
          && data.requesterName.size() <= 80
          && data.lastSenderId == request.auth.uid
          && data.lastMessage is string
          && data.lastMessage.size() > 0
          && data.lastMessage.size() <= 1000
          && data.lastMessageAt is timestamp
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && existsAfter(adoptionRequestPath(chatId))
          && getAfter(adoptionRequestPath(chatId)).data.requesterId
              == request.auth.uid
          && getAfter(adoptionRequestPath(chatId)).data.ownerId == data.ownerId
          && getAfter(adoptionRequestPath(chatId)).data.requesterName
              == data.requesterName
          && getAfter(adoptionRequestPath(chatId)).data.petId == data.petId
          && getAfter(adoptionRequestPath(chatId)).data.petName == data.petName
          && getAfter(adoptionRequestPath(chatId)).data.message == data.lastMessage
          && validChatMessageAfter(chatId, data);
    }

    function isChatParticipant(chatId) {
      return signedIn()
          && exists(chatPath(chatId))
          && request.auth.uid in get(chatPath(chatId)).data.participantIds;
    }

    function validChatUpdate(chatId) {
      return isChatParticipant(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage',
            'lastMessageId',
            'lastSenderId',
            'lastMessageAt',
            'updatedAt'
          ])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.requesterName == resource.data.requesterName
          && request.resource.data.petId == resource.data.petId
          && request.resource.data.petName == resource.data.petName
          && request.resource.data.participantIds == resource.data.participantIds
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 1000
          && request.resource.data.lastMessageAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && validChatMessageAfter(chatId, request.resource.data);
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
          && validProfile(request.resource.data, userId)
          && request.resource.data.email == request.auth.token.email;

      allow update: if ownsProfile(userId)
          && validProfile(request.resource.data, userId)
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'bio',
            'photoUrl',
            'updatedAt'
          ]);

      allow delete: if false;

      match /pets/{petId} {
        allow read: if ownsProfile(userId)
            || (signedIn() && resource.data.isForAdoption == true);
        allow create: if ownsProfile(userId)
            && validPet(request.resource.data, userId);
        allow update: if ownsProfile(userId)
            && validPet(request.resource.data, userId)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsProfile(userId);
      }
    }

    match /adoptionRequests/{requestId} {
      allow create: if signedIn()
          && validAdoptionRequest(request.resource.data);
      allow read: if signedIn()
          && (resource.data.requesterId == request.auth.uid
              || resource.data.ownerId == request.auth.uid);
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
          && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
          && validNewChat(request.resource.data, chatId);
      allow update: if validChatUpdate(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if signedIn()
            && existsAfter(chatPath(chatId))
            && request.auth.uid
                in getAfter(chatPath(chatId)).data.participantIds
            && validChatMessage(request.resource.data)
            && getAfter(chatPath(chatId)).data.lastMessageId == messageId
            && getAfter(chatPath(chatId)).data.lastMessage
                == request.resource.data.text
            && getAfter(chatPath(chatId)).data.lastSenderId == request.auth.uid
            && getAfter(chatPath(chatId)).data.lastMessageAt
                == request.resource.data.createdAt;
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && validPost(request.resource.data, request.auth.uid);
      allow update: if validLikeCountChange(postId);
      allow delete: if false;

      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn()
            && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
            && request.resource.data.keys().hasAll(['userId', 'createdAt'])
            && request.resource.data.userId == userId
            && request.resource.data.createdAt is timestamp
            && !exists(likePath(postId, userId))
            && get(parentPostPath(postId)).data.likeCount is int
            && getAfter(parentPostPath(postId)).data.likeCount
                == get(parentPostPath(postId)).data.likeCount + 1;
        allow update: if false;
        allow delete: if signedIn()
            && request.auth.uid == userId
            && get(parentPostPath(postId)).data.likeCount is int
            && getAfter(parentPostPath(postId)).data.likeCount
                == get(parentPostPath(postId)).data.likeCount - 1;
      }

      match /comments/{commentId} {
        allow read: if signedIn() && exists(parentPostPath(postId));
        allow create: if signedIn() && exists(parentPostPath(postId))
            && request.resource.data.keys().hasOnly([
              'authorId',
              'authorName',
              'text',
              'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'authorId',
              'authorName',
              'text',
              'createdAt'
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 80
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if signedIn() && exists(parentPostPath(postId))
            && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
